{
  "name": "afield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "npm run dev --workspace @afield/web --",
    "build": "npm run build --workspace @afield/web --",
    "start": "npm run start --workspace @afield/web --",
    "check": "npm run check --workspace @afield/web --",
    "test": "npm run test --workspace @afield/web --",
    "test:db": "npm run test:db --workspace @afield/web --",
    "test:e2e": "npm run test:e2e --workspace @afield/web --",
    "lint": "npm run lint --workspace @afield/web --",
    "preflight": "npm run preflight --workspace @afield/web --",
    "worker:dev": "npm run worker:dev --workspace @afield/web --",
    "worker:local": "npm run worker:local --workspace @afield/web --",
    "worker:deploy": "npm run worker:deploy --workspace @afield/web --",
    "docs:screenshots": "npm run docs:screenshots --workspace @afield/web --",
    "verify:repo": "node tooling/verify-repository.mjs"
  },
  "overrides": {
    "ws": "8.21.0"
  }
